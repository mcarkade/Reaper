# Keep exact released bytes, including hashed verification inputs, on every OS.
* -text -diff
*.md -text diff whitespace=cr-at-eol
*.json -text diff whitespace=cr-at-eol
*.csv -text diff whitespace=cr-at-eol
*.tsv -text diff whitespace=cr-at-eol
*.txt -text diff whitespace=cr-at-eol
.gitignore -text diff
.gitattributes -text diff
